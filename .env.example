# Neon Postgres 接続文字列（Neon コンソール > Connection Details）
# 例: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/reconfeed?sslmode=require&sslnegotiation=direct
# 注意: Neon (Postgres 18) は Direct SSL Negotiation を要求する。psycopg[binary]>=3.3.4 と
# 接続文字列末尾の sslnegotiation=direct が両方必要（片方だけだと「connection closed unexpectedly」で失敗する）
DATABASE_URL=

# セッションCookie署名鍵。ランダムな長い文字列を自分で生成する
# 生成例（Git Bash）: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# NVD API Key（https://nvd.nist.gov/developers/request-an-api-key）
NVD_API_KEY=

# GitHub Fine-grained Personal Access Token（Public repositories read-only で作成）
GITHUB_TOKEN=

# Resend API Key（https://resend.com ダッシュボード > API Keys、Sending access権限）
RESEND_API_KEY=

# 送信元メールアドレス。検証段階は onboarding@resend.dev でOK（自分宛のみ送信可）
RESEND_FROM_EMAIL=onboarding@resend.dev

# ローカル開発時のアプリURL（メール本文のリンク生成に使用）
APP_BASE_URL=http://localhost:8000

# デモ環境の注意書き（サインアップ・ダッシュボード）を表示するか。
# 独自ドメインをResendに検証し、本番運用へ移行したら false にする
DEMO_MODE=true
